# Copy outside source control, fill with staging-only values, and pass with
# `docker compose --env-file <path> -f deploy/hosted-staging.compose.yml ...`.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_PASSWORD=

# Include URL-encoded credentials matching the services above or managed services.
DATABASE_URL=
REDIS_URL=

API_PUBLIC_URL=https://api.staging.example.com
WEB_PUBLIC_URL=https://learn.staging.example.com
CORS_ORIGIN=https://learn.staging.example.com
NEXT_PUBLIC_API_URL=https://api.staging.example.com

# Generate independent high-entropy values; never reuse production secrets.
JWT_SECRET=
AUTH_OPERATIONAL_CONTROL_KEY_SECRET=

# Private S3-compatible storage. Values are staging-only secret-manager/runtime
# references; do not store credentials in this file or source control.
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=
UPLOAD_S3_ENDPOINT=
UPLOAD_S3_FORCE_PATH_STYLE=false
UPLOAD_S3_CREDENTIALS_REFERENCE=
UPLOAD_S3_ACCESS_KEY_ID=
UPLOAD_S3_SECRET_ACCESS_KEY=
UPLOAD_S3_KEY_PREFIX=minhhuong-staging
UPLOAD_S3_TIMEOUT_MS=5000
UPLOAD_S3_MAX_ATTEMPTS=3
UPLOAD_STORAGE_TOPOLOGY=shared-object
API_REPLICA_COUNT=1

API_BIND_ADDRESS=127.0.0.1
API_PUBLISHED_PORT=4000
WEB_BIND_ADDRESS=127.0.0.1
WEB_PUBLISHED_PORT=3000
