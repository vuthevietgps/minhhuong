{
  "name": "minhhuong-learning-platform",
  "version": "0.1.0",
  "private": true,
  "description": "English learning platform with NestJS API, PostgreSQL, and Next.js web app.",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm --prefix apps/api run start:dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "npm --prefix apps/api run lint",
    "lint:fix:api": "npm --prefix apps/api run lint:fix",
    "lint:web": "npm --prefix apps/web run lint",
    "check:file-length": "node scripts/check-file-length.mjs",
    "test:scripts": "node --test scripts/check-file-length.test.mjs",
    "test": "npm --prefix apps/api run test",
    "test:extension": "npm --prefix minhhuongextension test",
    "test:browser-control": "npm --prefix apps/api run test:browser-control",
    "smoke:browser-control": "node scripts/smoke-browser-control.mjs",
    "package:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Package-MinhhuongExtension.ps1",
    "seed:demo": "npm --prefix apps/api run seed:demo",
    "test:erp-local": "npm --prefix apps/api run test:erp-local",
    "test:learning-local": "npm --prefix apps/api run test:learning-local",
    "report:demo": "npm --prefix apps/api run report:demo",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:local:start": "powershell -ExecutionPolicy Bypass -File scripts/Start-LocalPostgres.ps1",
    "db:local:stop": "powershell -ExecutionPolicy Bypass -File scripts/Stop-LocalPostgres.ps1",
    "prisma:generate": "npm --prefix apps/api run prisma:generate",
    "prisma:validate": "npm --prefix apps/api run prisma:validate",
    "prisma:migrate": "npm --prefix apps/api run prisma:migrate",
    "prisma:studio": "npm --prefix apps/api run prisma:studio",
    "prisma:seed": "npm --prefix apps/api run prisma:seed",
    "test:deployment-contract": "node --test scripts/deployment-contract.test.mjs apps/api/scripts/run-hosted-migration.test.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "build:containers": "docker build -f apps/api/Dockerfile --target api-runtime -t minhhuong-api:staging-local . && docker build -f apps/web/Dockerfile --target web-runtime --build-arg NEXT_PUBLIC_API_URL=https://api.staging.example.test -t minhhuong-web:staging-local .",
    "smoke:hosted-staging": "node scripts/smoke-hosted-staging.mjs",
    "uploads:migration:inventory": "npm --prefix apps/api run uploads:migration:inventory"
  },
  "keywords": [
    "nestjs",
    "nextjs",
    "postgresql",
    "english-learning"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
