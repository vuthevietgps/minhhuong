generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum LessonType {
  VIDEO
  QUIZ
  READING
  SPEAKING
  MIXED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT_INPUT
  ORDERING
  SPEAKING
}

enum ActivityType {
  QUIZ
  VOCAB_GAME
  LISTENING
  SPEAKING
  WRITING
  AI_CHAT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum ContentPublishStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum LearningPathStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentPackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ChildContentAssignmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REVOKED
}

enum VideoProvider {
  INTERNAL
  YOUTUBE
  EXTERNAL
}

enum VideoProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum ActivationOrderStatus {
  WAITING_PAYMENT
  PENDING_REVIEW
  APPROVED
  REJECTED
  CANCELED
  REVOKED
}

enum ActivationOrderSource {
  SALE_ASSISTED
  SELF_SERVICE
}

enum PackageEntitlementStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
}

enum AgencyMemberRole {
  OWNER
  MANAGER
  SALE
}

enum ChannelParticipantType {
  DIRECTOR
  MANAGER
  AGENCY
  SALE
}

enum ChannelParticipantStatus {
  ACTIVE
  SUSPENDED
}

enum AffiliateLinkStatus {
  ACTIVE
  PAUSED
  EXPIRED
  REVOKED
}

enum AffiliateQrAssetStatus {
  ACTIVE
  PAUSED
  REVOKED
}

enum CommissionBeneficiaryType {
  SALE
  AGENCY
}

enum CommissionStatus {
  PENDING
  AVAILABLE
  CANCELED
}

enum CommissionLedgerEntryType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
}

enum PayoutRequestStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAID
  CANCELED
}

enum IdempotencyRecordStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum AiMessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum AuthSessionState {
  ACTIVE
  ENDED
  REVOKED
  EXPIRED
}

enum AuthRefreshTokenState {
  ACTIVE
  ROTATED
  REUSED
  REVOKED
  EXPIRED
}

enum AuthSessionAuditAction {
  SESSION_CREATED
  SESSION_ENDED
  SESSION_REVOKED
  SESSION_EXPIRED
  REFRESH_TOKEN_ISSUED
  REFRESH_TOKEN_ROTATED
  REFRESH_TOKEN_DENIED
  REFRESH_TOKEN_REUSE_DENIED
  SESSION_CLEANUP_EXPIRED
}

enum ContentTagKind {
  TOPIC
  AUDIENCE
  LEVEL
  SKILL
  FORMAT
  INTENT
  CUSTOM
}

enum LearningDeviceType {
  PHONE
  TABLET
  COMPUTER
  UNKNOWN
}

enum DailyLearningPlanStatus {
  ACTIVE
  COMPLETED
  SKIPPED
  EXPIRED
}

enum DailyLearningPlanContentSourceMode {
  ASSIGNED_PATH
  UNASSIGNED_FALLBACK
}

enum DailyLearningPlanGeneratedBy {
  SYSTEM_RULE
}

enum DailyLearningPlanItemType {
  VIDEO
  PRACTICE
  REVIEW
  AI_CONVERSATION
  REWARD
}

enum DailyLearningPlanItemStatus {
  READY
  STARTED
  COMPLETED
  SKIPPED
  LOCKED
}

enum VideoExposureEventType {
  STARTED
  PROGRESSED
  COMPLETED
  REPLAYED
  SKIPPED
}

enum VideoExposureSource {
  RUNTIME_WATCH_EVENT
  HEARTBEAT
  MANUAL_SAFE
  LEGACY_PROGRESS
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique
  passwordHash             String
  status                   UserStatus              @default(ACTIVE)
  suspendReason            String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  profile                  Profile?
  roles                    UserRole[]
  childProfiles            ChildProfile[]
  payments                 Payment[]
  walletEntries            WalletLedgerEntry[]
  auditLogs                AuditLog[]
  activationOrders         ActivationOrder[]       @relation("ActivationOrderUser")
  createdActivationOrders  ActivationOrder[]       @relation("ActivationOrderCreator")
  reviewedActivationOrders ActivationOrder[]       @relation("ActivationOrderReviewer")
  agencyMemberships        AgencyMember[]
  channelParticipant       ChannelParticipant?     @relation("ChannelParticipantUser")
  commissionEarnings       CommissionEarning[]     @relation("CommissionBeneficiaryUser")
  commissionLedgerEntries  CommissionLedgerEntry[]
  payoutRequests           PayoutRequest[]         @relation("PayoutBeneficiaryUser")
  reviewedPayoutRequests   PayoutRequest[]         @relation("PayoutReviewerUser")
  grantedDeviceTime        DeviceTimeGrant[]       @relation("DeviceTimeGrantedBy")
  revokedActivationOrders  ActivationOrder[]       @relation("ActivationOrderRevoker")
  orderStatusHistories     OrderStatusHistory[]    @relation("OrderStatusHistoryActor")
  idempotencyRecords       IdempotencyRecord[]     @relation("IdempotencyRecordActor")
  createdAffiliateLinks    AffiliateLink[]         @relation("AffiliateLinkCreator")
  createdAffiliateQrAssets AffiliateQrAsset[]      @relation("AffiliateQrAssetCreator")
  passwordResetTokens      PasswordResetToken[]
  authSessions             AuthSession[]
  authRefreshTokens        AuthRefreshToken[]

  @@index([status])
  @@index([createdAt, id])
  @@index([status, createdAt])
}

model ChildProfile {
  id                 String                   @id @default(cuid())
  parentId           String
  displayName        String
  avatarUrl          String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  parent             User                     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  subscriptions      Subscription[]
  lessonProgress     LessonProgress[]
  activityAttempts   ActivityAttempt[]
  learningUsageDays  LearningUsageDay[]
  aiSessions         AiChatSession[]
  activationOrders   ActivationOrder[]
  screenTime         ChildScreenTimeSetting?
  deviceTimeGrants   DeviceTimeGrant[]
  contentAssignments ChildContentAssignment[]
  dailyLearningPlans DailyLearningPlan[]
  videoExposureLogs  VideoExposureLog[]

  @@index([parentId])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  avatarUrl   String?
  locale      String   @default("vi-VN")
  timezone    String   @default("Asia/Bangkok")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  users       UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model ChildScreenTimeSetting {
  id                String       @id @default(cuid())
  childProfileId    String       @unique
  isEnabled         Boolean      @default(false)
  dailyLimitMinutes Int          @default(45)
  updatedAt         DateTime     @updatedAt
  childProfile      ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
}

model LearningUsageDay {
  id             String             @id @default(cuid())
  childProfileId String
  usageDate      String
  deviceType     LearningDeviceType @default(UNKNOWN)
  usedSeconds    Int                @default(0)
  lastRecordedAt DateTime           @default(now())
  childProfile   ChildProfile       @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, usageDate, deviceType])
  @@index([childProfileId, usageDate])
}

model DeviceTimeGrant {
  id             String       @id @default(cuid())
  childProfileId String
  grantedById    String
  usageDate      String
  extraMinutes   Int
  note           String?
  createdAt      DateTime     @default(now())
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  grantedBy      User         @relation("DeviceTimeGrantedBy", fields: [grantedById], references: [id], onDelete: Cascade)

  @@index([childProfileId, usageDate])
  @@index([grantedById, createdAt])
}

model Level {
  id            String         @id @default(cuid())
  code          String         @unique
  title         String
  description   String?
  sortOrder     Int            @default(0)
  courses       Course[]
  learningPaths LearningPath[]
}

model Course {
  id          String   @id @default(cuid())
  levelId     String
  slug        String   @unique
  title       String
  description String?
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  level       Level    @relation(fields: [levelId], references: [id])
  units       Unit[]

  @@index([levelId, isPublished])
}

model Unit {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  sortOrder   Int      @default(0)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId, sortOrder])
}

model Lesson {
  id                String                  @id @default(cuid())
  unitId            String
  slug              String                  @unique
  title             String
  description       String?
  type              LessonType              @default(MIXED)
  status            ContentPublishStatus    @default(DRAFT)
  durationSec       Int?
  sortOrder         Int                     @default(0)
  publishedAt       DateTime?
  createdById       String?
  updatedById       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @default(now()) @updatedAt
  unit              Unit                    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  videos            VideoAsset[]
  activities        Activity[]
  progress          LessonProgress[]
  tags              LessonTag[]
  learningPathItems LearningPathItem[]
  dailyPlanItems    DailyLearningPlanItem[]
  videoExposureLogs VideoExposureLog[]

  @@index([unitId, status, sortOrder])
}

model LearningPath {
  id          String              @id @default(cuid())
  code        String              @unique
  title       String
  description String?
  levelId     String?
  ageBand     String?
  status      LearningPathStatus  @default(DRAFT)
  revision    Int                 @default(1)
  createdById String?
  updatedById String?
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  level       Level?              @relation(fields: [levelId], references: [id], onDelete: SetNull)
  items       LearningPathItem[]
  packages    ContentPackage[]
  dailyPlans  DailyLearningPlan[]

  @@index([status])
  @@index([levelId, status])
}

model LearningPathItem {
  id                 String                  @id @default(cuid())
  learningPathId     String
  sequence           Int
  lessonId           String
  required           Boolean                 @default(true)
  minScore           Int?
  minWatchPercent    Int?
  prerequisiteItemId String?
  reviewPolicyJson   Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  learningPath       LearningPath            @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  lesson             Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  prerequisiteItem   LearningPathItem?       @relation("LearningPathItemPrerequisite", fields: [prerequisiteItemId], references: [id], onDelete: SetNull)
  dependentItems     LearningPathItem[]      @relation("LearningPathItemPrerequisite")
  dailyPlanItems     DailyLearningPlanItem[]

  @@unique([learningPathId, sequence])
  @@unique([learningPathId, lessonId])
  @@index([lessonId])
  @@index([prerequisiteItemId])
}

model ContentPackage {
  id             String                   @id @default(cuid())
  code           String                   @unique
  title          String
  description    String?
  learningPathId String
  planId         String?
  status         ContentPackageStatus     @default(DRAFT)
  createdById    String?
  publishedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  learningPath   LearningPath             @relation(fields: [learningPathId], references: [id], onDelete: Restrict)
  plan           Plan?                    @relation(fields: [planId], references: [id], onDelete: SetNull)
  assignments    ChildContentAssignment[]
  dailyPlans     DailyLearningPlan[]

  @@index([learningPathId, status])
  @@index([planId, status])
}

model ChildContentAssignment {
  id               String                       @id @default(cuid())
  childProfileId   String
  contentPackageId String
  assignedById     String?
  status           ChildContentAssignmentStatus @default(ACTIVE)
  startedAt        DateTime                     @default(now())
  endedAt          DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  childProfile     ChildProfile                 @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  contentPackage   ContentPackage               @relation(fields: [contentPackageId], references: [id], onDelete: Restrict)

  @@index([childProfileId, status])
  @@index([contentPackageId, status])
}

model DailyLearningPlan {
  id                String                             @id @default(cuid())
  childProfileId    String
  planDate          String
  status            DailyLearningPlanStatus            @default(ACTIVE)
  contentSourceMode DailyLearningPlanContentSourceMode
  contentPackageId  String?
  learningPathId    String?
  targetMinutes     Int?
  generatedBy       DailyLearningPlanGeneratedBy       @default(SYSTEM_RULE)
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  childProfile      ChildProfile                       @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  contentPackage    ContentPackage?                    @relation(fields: [contentPackageId], references: [id], onDelete: SetNull)
  learningPath      LearningPath?                      @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  items             DailyLearningPlanItem[]

  @@unique([childProfileId, planDate])
  @@index([childProfileId, status, planDate])
  @@index([contentPackageId])
  @@index([learningPathId])
}

model DailyLearningPlanItem {
  id                 String                      @id @default(cuid())
  planId             String
  sequence           Int
  itemType           DailyLearningPlanItemType
  lessonId           String?
  activityId         String?
  learningPathItemId String?
  required           Boolean                     @default(true)
  status             DailyLearningPlanItemStatus @default(READY)
  minWatchPercent    Int?
  minScore           Int?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  plan               DailyLearningPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  lesson             Lesson?                     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  activity           Activity?                   @relation(fields: [activityId], references: [id], onDelete: SetNull)
  learningPathItem   LearningPathItem?           @relation(fields: [learningPathItemId], references: [id], onDelete: SetNull)

  @@unique([planId, sequence])
  @@index([planId, status])
  @@index([lessonId])
  @@index([activityId])
  @@index([learningPathItemId])
}

model ContentTag {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  kind        ContentTagKind @default(TOPIC)
  description String?
  color       String?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lessons     LessonTag[]

  @@index([kind, isActive, sortOrder])
}

model LessonTag {
  lessonId   String
  tagId      String
  assignedAt DateTime   @default(now())
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tag        ContentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([lessonId, tagId])
  @@index([tagId])
}

model VideoAsset {
  id               String                @id @default(cuid())
  lessonId         String
  title            String?
  provider         VideoProvider
  processingStatus VideoProcessingStatus @default(READY)
  playbackId       String
  sourceUrl        String?
  embedUrl         String?
  storageKey       String?
  mimeType         String?
  fileSizeBytes    Int?
  durationSec      Int?
  captionsUrl      String?
  thumbnailUrl     String?
  sortOrder        Int                   @default(0)
  uploadedById     String?
  errorMessage     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt
  lesson           Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exposureLogs     VideoExposureLog[]

  @@index([lessonId, provider, processingStatus])
}

model VideoExposureLog {
  id                 String                 @id @default(cuid())
  childProfileId     String
  lessonId           String
  videoAssetId       String?
  eventType          VideoExposureEventType
  positionSec        Int                    @default(0)
  durationWatchedSec Int                    @default(0)
  watchPercent       Int                    @default(0)
  source             VideoExposureSource    @default(RUNTIME_WATCH_EVENT)
  createdAt          DateTime               @default(now())
  childProfile       ChildProfile           @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  lesson             Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  videoAsset         VideoAsset?            @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)

  @@index([childProfileId, lessonId, createdAt])
  @@index([childProfileId, lessonId, watchPercent])
  @@index([videoAssetId])
  @@index([eventType, createdAt])
}

model Activity {
  id             String                  @id @default(cuid())
  lessonId       String
  title          String
  description    String?
  type           ActivityType            @default(QUIZ)
  sortOrder      Int                     @default(0)
  lesson         Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions      Question[]
  attempts       ActivityAttempt[]
  dailyPlanItems DailyLearningPlanItem[]
}

model Question {
  id          String            @id @default(cuid())
  activityId  String
  type        QuestionType
  prompt      String
  explanation String?
  points      Int               @default(1)
  metadata    Json?
  sortOrder   Int               @default(0)
  activity    Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  answers     Answer[]
  attempts    QuestionAttempt[]
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  sortOrder  Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id              String         @id @default(cuid())
  childProfileId  String
  lessonId        String
  status          ProgressStatus @default(NOT_STARTED)
  score           Int?
  completedAt     DateTime?
  lastPositionSec Int            @default(0)
  watchCount      Int            @default(0)
  lastWatchedAt   DateTime?
  isFavorite      Boolean        @default(false)
  updatedAt       DateTime       @updatedAt
  childProfile    ChildProfile   @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  lesson          Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, lessonId])
  @@index([childProfileId, isFavorite])
  @@index([childProfileId, lastWatchedAt])
}

model ActivityAttempt {
  id             String            @id @default(cuid())
  childProfileId String
  activityId     String
  status         AttemptStatus     @default(SUBMITTED)
  score          Int               @default(0)
  maxScore       Int               @default(0)
  startedAt      DateTime          @default(now())
  submittedAt    DateTime?
  childProfile   ChildProfile      @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  activity       Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  responses      QuestionAttempt[]

  @@index([childProfileId, activityId, submittedAt])
}

model QuestionAttempt {
  id                String          @id @default(cuid())
  attemptId         String
  questionId        String
  selectedAnswerIds Json?
  textAnswer        String?
  orderedAnswer     Json?
  isCorrect         Boolean         @default(false)
  score             Int             @default(0)
  feedback          String?
  createdAt         DateTime        @default(now())
  attempt           ActivityAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Plan {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  priceCents      Int
  currency        String           @default("VND")
  billingCycle    BillingCycle
  isActive        Boolean          @default(true)
  subscriptions   Subscription[]
  contentPackages ContentPackage[]
}

model Subscription {
  id                      String             @id @default(cuid())
  childProfileId          String
  planId                  String
  sourceOrderId           String?
  activationPackageId     String?
  entitlementSnapshotJson Json?
  status                  SubscriptionStatus @default(TRIALING)
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  cancelAtPeriodEnd       Boolean            @default(false)
  providerRef             String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  childProfile            ChildProfile       @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  plan                    Plan               @relation(fields: [planId], references: [id])
  sourceOrder             ActivationOrder?   @relation("SubscriptionSourceOrder", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  activationPackage       ActivationPackage? @relation("SubscriptionActivationPackage", fields: [activationPackageId], references: [id], onDelete: SetNull)
  payments                Payment[]

  @@index([childProfileId, status])
  @@index([sourceOrderId])
  @@index([activationPackageId])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amountCents    Int
  currency       String        @default("VND")
  status         PaymentStatus @default(PENDING)
  provider       String
  providerRef    String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
}

model Agency {
  id                   String                  @id @default(cuid())
  code                 String                  @unique
  name                 String
  status               AgencyStatus            @default(ACTIVE)
  defaultRateBps       Int                     @default(0)
  notes                String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  members              AgencyMember[]
  channelParticipant   ChannelParticipant?
  activationOrders     ActivationOrder[]
  commissions          CommissionEarning[]
  ledgerEntries        CommissionLedgerEntry[]
  payoutRequests       PayoutRequest[]
  affiliateLinks       AffiliateLink[]
  affiliateClickEvents AffiliateClickEvent[]

  @@index([status])
}

model AgencyMember {
  id                       String                @id @default(cuid())
  agencyId                 String
  userId                   String
  role                     AgencyMemberRole      @default(SALE)
  title                    String?
  rateBps                  Int?
  referralCode             String?               @unique
  isActive                 Boolean               @default(true)
  createdAt                DateTime              @default(now())
  agency                   Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredActivationOrders ActivationOrder[]     @relation("ActivationOrderReferrerMember")
  affiliateLinks           AffiliateLink[]
  affiliateClickEvents     AffiliateClickEvent[]

  @@unique([agencyId, userId])
  @@index([userId, isActive])
  @@index([agencyId, role, isActive])
}

model ChannelParticipant {
  id                   String                   @id @default(cuid())
  type                 ChannelParticipantType
  code                 String                   @unique
  displayName          String
  status               ChannelParticipantStatus @default(ACTIVE)
  userId               String?                  @unique
  agencyId             String?                  @unique
  parentParticipantId  String?
  rootParticipantId    String?
  lineage              String                   @default("")
  depth                Int                      @default(0)
  baseSalaryCents      Int                      @default(0)
  commissionRateBps    Int?
  kpiBonusConfig       Json?
  penaltyConfig        Json?
  notes                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  user                 User?                    @relation("ChannelParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  agency               Agency?                  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  parentParticipant    ChannelParticipant?      @relation("ChannelParticipantTree", fields: [parentParticipantId], references: [id], onDelete: SetNull)
  childParticipants    ChannelParticipant[]     @relation("ChannelParticipantTree")
  activationOrders     ActivationOrder[]
  commissionEarnings   CommissionEarning[]
  ledgerEntries        CommissionLedgerEntry[]
  payoutRequests       PayoutRequest[]
  affiliateLinks       AffiliateLink[]
  affiliateClickEvents AffiliateClickEvent[]

  @@index([type, status])
  @@index([parentParticipantId])
  @@index([rootParticipantId])
  @@index([lineage])
}

model AffiliateLink {
  id               String                @id @default(cuid())
  participantId    String
  agencyId         String?
  agencyMemberId   String?
  createdById      String
  referralCode     String?
  linkCode         String                @unique
  name             String
  campaign         String?
  channel          String?
  placement        String?
  packageCode      String?
  packageScopeJson Json?
  status           AffiliateLinkStatus   @default(ACTIVE)
  startsAt         DateTime?
  expiresAt        DateTime?
  metadataJson     Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  participant      ChannelParticipant    @relation(fields: [participantId], references: [id])
  agency           Agency?               @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  agencyMember     AgencyMember?         @relation(fields: [agencyMemberId], references: [id], onDelete: SetNull)
  createdBy        User                  @relation("AffiliateLinkCreator", fields: [createdById], references: [id])
  qrAssets         AffiliateQrAsset[]
  clickEvents      AffiliateClickEvent[]

  @@index([participantId, status])
  @@index([agencyId, status])
  @@index([campaign])
  @@index([createdAt])
}

model AffiliateQrAsset {
  id              String                 @id @default(cuid())
  affiliateLinkId String
  createdById     String
  label           String?
  placement       String?
  encodedUrl      String
  qrImageUrl      String?
  status          AffiliateQrAssetStatus @default(ACTIVE)
  metadataJson    Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  affiliateLink   AffiliateLink          @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  createdBy       User                   @relation("AffiliateQrAssetCreator", fields: [createdById], references: [id])
  clickEvents     AffiliateClickEvent[]

  @@index([affiliateLinkId, status])
  @@index([placement])
  @@index([createdAt])
}

model AffiliateClickEvent {
  id                 String             @id @default(cuid())
  affiliateLinkId    String
  affiliateQrAssetId String?
  participantId      String
  agencyId           String?
  agencyMemberId     String?
  referralCode       String?
  clickId            String             @unique
  dedupeKeyHash      String?            @unique
  ipHash             String?
  userAgentHash      String?
  deviceHint         String?
  redirectUrl        String
  campaign           String?
  channel            String?
  placement          String?
  packageCode        String?
  metadataJson       Json?
  createdAt          DateTime           @default(now())
  affiliateLink      AffiliateLink      @relation(fields: [affiliateLinkId], references: [id])
  affiliateQrAsset   AffiliateQrAsset?  @relation(fields: [affiliateQrAssetId], references: [id], onDelete: SetNull)
  participant        ChannelParticipant @relation(fields: [participantId], references: [id])
  agency             Agency?            @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  agencyMember       AgencyMember?      @relation(fields: [agencyMemberId], references: [id], onDelete: SetNull)

  @@index([affiliateLinkId, createdAt])
  @@index([affiliateQrAssetId, createdAt])
  @@index([participantId, createdAt])
  @@index([campaign, createdAt])
}

model CommissionPolicy {
  id                 String                    @id @default(cuid())
  code               String                    @unique
  name               String
  beneficiaryType    CommissionBeneficiaryType
  rateBps            Int
  baseSalaryCents    Int                       @default(0)
  kpiBonusConfig     Json?
  penaltyConfig      Json?
  isDefaultForSale   Boolean                   @default(false)
  isDefaultForAgency Boolean                   @default(false)
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  earnings           CommissionEarning[]

  @@index([beneficiaryType, isActive])
}

model CommissionEarning {
  id                      String                    @id @default(cuid())
  activationOrderId       String
  participantId           String?
  beneficiaryType         CommissionBeneficiaryType
  beneficiaryUserId       String?
  beneficiaryAgencyId     String?
  policyId                String?
  baseAmountCents         Int
  rateBps                 Int
  amountCents             Int
  currency                String                    @default("VND")
  attributionSnapshotJson Json?
  status                  CommissionStatus          @default(PENDING)
  depth                   Int                       @default(0)
  availableAt             DateTime?
  releasedAt              DateTime?
  createdAt               DateTime                  @default(now())
  activationOrder         ActivationOrder           @relation(fields: [activationOrderId], references: [id], onDelete: Cascade)
  participant             ChannelParticipant?       @relation(fields: [participantId], references: [id], onDelete: SetNull)
  beneficiaryUser         User?                     @relation("CommissionBeneficiaryUser", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  beneficiaryAgency       Agency?                   @relation(fields: [beneficiaryAgencyId], references: [id], onDelete: SetNull)
  policy                  CommissionPolicy?         @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([activationOrderId])
  @@index([participantId, status])
  @@index([beneficiaryUserId, status])
  @@index([beneficiaryAgencyId, status])
  @@index([status, availableAt])
}

model CommissionLedgerEntry {
  id                  String                    @id @default(cuid())
  participantId       String?
  beneficiaryUserId   String?
  beneficiaryAgencyId String?
  type                CommissionLedgerEntryType
  amountCents         Int
  currency            String                    @default("VND")
  reason              String
  referenceType       String?
  referenceId         String?
  createdAt           DateTime                  @default(now())
  participant         ChannelParticipant?       @relation(fields: [participantId], references: [id], onDelete: SetNull)
  beneficiaryUser     User?                     @relation(fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  beneficiaryAgency   Agency?                   @relation(fields: [beneficiaryAgencyId], references: [id], onDelete: SetNull)

  @@index([participantId, createdAt])
  @@index([beneficiaryUserId, createdAt])
  @@index([beneficiaryAgencyId, createdAt])
}

model PayoutRequest {
  id                         String              @id @default(cuid())
  participantId              String?
  beneficiaryUserId          String?
  beneficiaryAgencyId        String?
  reviewedById               String?
  status                     PayoutRequestStatus @default(PENDING_REVIEW)
  amountCents                Int
  currency                   String              @default("VND")
  bankName                   String
  bankAccountNumber          String
  bankAccountName            String
  requestNotes               String?
  reviewNotes                String?
  payoutInvoiceUrl           String?
  payoutInvoiceStorageKey    String?
  payoutInvoiceMimeType      String?
  payoutInvoiceFileSizeBytes Int?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  paidAt                     DateTime?
  participant                ChannelParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  beneficiaryUser            User?               @relation("PayoutBeneficiaryUser", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  beneficiaryAgency          Agency?             @relation(fields: [beneficiaryAgencyId], references: [id], onDelete: SetNull)
  reviewedBy                 User?               @relation("PayoutReviewerUser", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([participantId, status])
  @@index([beneficiaryUserId, status])
  @@index([beneficiaryAgencyId, status])
  @@index([status, createdAt])
}

model ActivationOrder {
  id                               String                @id @default(cuid())
  userId                           String
  childProfileId                   String?
  createdById                      String?
  reviewedById                     String?
  revokedById                      String?
  channelParticipantId             String?
  agencyId                         String?
  referrerMemberId                 String?
  status                           ActivationOrderStatus @default(PENDING_REVIEW)
  source                           ActivationOrderSource @default(SALE_ASSISTED)
  customerEmail                    String
  amountCents                      Int
  currency                         String                @default("VND")
  packageCode                      String?
  packageName                      String?
  requestedDurationDays            Int?
  durationDays                     Int?
  entitlementSnapshotJson          Json?
  affiliateAttributionSnapshotJson Json?
  commissionChainSnapshotJson      Json?
  bankName                         String?
  bankAccountNumber                String?
  bankAccountName                  String?
  transferContent                  String?
  saleInvoiceUrl                   String?
  saleInvoiceStorageKey            String?
  saleInvoiceMimeType              String?
  saleInvoiceFileSizeBytes         Int?
  operationInvoiceUrl              String?
  operationInvoiceStorageKey       String?
  operationInvoiceMimeType         String?
  operationInvoiceFileSizeBytes    Int?
  notes                            String?
  customerPhone                    String?
  reviewNotes                      String?
  activatedAt                      DateTime?
  trialEndsAt                      DateTime?
  expiresAt                        DateTime?
  revokedAt                        DateTime?
  revokeReason                     String?
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  user                             User                  @relation("ActivationOrderUser", fields: [userId], references: [id], onDelete: Cascade)
  childProfile                     ChildProfile?         @relation(fields: [childProfileId], references: [id], onDelete: SetNull)
  createdBy                        User?                 @relation("ActivationOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy                       User?                 @relation("ActivationOrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  revokedBy                        User?                 @relation("ActivationOrderRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  channelParticipant               ChannelParticipant?   @relation(fields: [channelParticipantId], references: [id], onDelete: SetNull)
  agency                           Agency?               @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  referrerMember                   AgencyMember?         @relation("ActivationOrderReferrerMember", fields: [referrerMemberId], references: [id], onDelete: SetNull)
  commissionEarnings               CommissionEarning[]
  subscriptions                    Subscription[]        @relation("SubscriptionSourceOrder")
  statusHistory                    OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([userId])
  @@index([childProfileId])
  @@index([channelParticipantId])
  @@index([agencyId])
  @@index([referrerMemberId])
  @@index([revokedById])
  @@index([trialEndsAt])
}

model ActivationPackage {
  id            String               @id @default(cuid())
  code          String               @unique
  name          String
  description   String?
  amountVnd     Int
  durationDays  Int
  version       Int                  @default(1)
  isActive      Boolean              @default(true)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  subscriptions Subscription[]       @relation("SubscriptionActivationPackage")
  entitlements  PackageEntitlement[]

  @@index([isActive, sortOrder])
}

model PackageEntitlement {
  id             String                   @id @default(cuid())
  packageId      String
  entitlementKey String
  valueJson      Json
  status         PackageEntitlementStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  package        ActivationPackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([entitlementKey, status])
}

model OrderStatusHistory {
  id           String                 @id @default(cuid())
  orderId      String
  fromStatus   ActivationOrderStatus?
  toStatus     ActivationOrderStatus
  action       String
  actorUserId  String?
  reason       String?
  metadataJson Json?
  createdAt    DateTime               @default(now())
  order        ActivationOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor        User?                  @relation("OrderStatusHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}

model IdempotencyRecord {
  id           String                  @id @default(cuid())
  scope        String
  key          String
  actorUserId  String?
  resourceType String
  resourceId   String?
  requestHash  String
  status       IdempotencyRecordStatus @default(IN_PROGRESS)
  responseJson Json?
  errorCode    String?
  expiresAt    DateTime
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  actor        User?                   @relation("IdempotencyRecordActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([scope, key])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([status, expiresAt])
}

model WalletLedgerEntry {
  id            String          @id @default(cuid())
  userId        String
  type          LedgerEntryType
  amountCents   Int
  currency      String          @default("VND")
  reason        String
  referenceType String?
  referenceId   String?
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AiChatSession {
  id             String          @id @default(cuid())
  childProfileId String
  title          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  childProfile   ChildProfile    @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  messages       AiChatMessage[]
}

model AiChatMessage {
  id        String        @id @default(cuid())
  sessionId String
  role      AiMessageRole
  content   String
  metadata  Json?
  createdAt DateTime      @default(now())
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
}

model AuthSession {
  id            String             @id
  userId        String             @map("user_id")
  email         String
  roles         Json
  deviceId      String             @map("device_id")
  state         AuthSessionState
  issuedAt      DateTime           @map("issued_at")
  expiresAt     DateTime           @map("expires_at")
  endedAt       DateTime?          @map("ended_at")
  revokedAt     DateTime?          @map("revoked_at")
  reason        String?
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, state, expiresAt])
  @@index([deviceId, state])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id                String                @id
  sessionId         String                @map("session_id")
  userId            String                @map("user_id")
  deviceId          String                @map("device_id")
  tokenHash         String                @map("token_hash")
  state             AuthRefreshTokenState
  issuedAt          DateTime              @map("issued_at")
  expiresAt         DateTime              @map("expires_at")
  rotatedAt         DateTime?             @map("rotated_at")
  reusedAt          DateTime?             @map("reused_at")
  revokedAt         DateTime?             @map("revoked_at")
  replacedByTokenId String?               @map("replaced_by_token_id")
  reason            String?
  session           AuthSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, state])
  @@index([userId, state, expiresAt])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("auth_refresh_tokens")
}

model AuthSessionAuditEvent {
  id             String                 @id
  createdAt      DateTime               @map("created_at")
  action         AuthSessionAuditAction
  sessionId      String?                @map("session_id")
  refreshTokenId String?                @map("refresh_token_id")
  userId         String?                @map("user_id")
  deviceId       String?                @map("device_id")
  reason         String?
  visibleToRoles String[]               @map("visible_to_roles")
  metadata       Json?

  @@index([createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("auth_session_audit_events")
}

model AuthRateLimitAttempt {
  id          String   @id
  surface     String
  keyHash     String   @map("key_hash")
  attemptedAt DateTime @map("attempted_at")
  expiresAt   DateTime @map("expires_at")

  @@index([surface, keyHash, attemptedAt])
  @@index([expiresAt])
  @@map("operational_auth_rate_limit_attempts")
}

model AuthOperationalMetricBucket {
  kind            String
  bucketStartedAt DateTime @map("bucket_started_at")
  count           Int
  lastOccurredAt  DateTime @map("last_occurred_at")
  expiresAt       DateTime @map("expires_at")

  @@id([kind, bucketStartedAt])
  @@index([expiresAt])
  @@map("operational_auth_metric_buckets")
}

model AuthOperationalAlertState {
  fingerprint   String   @id
  alertCode     String   @map("alert_code")
  lastOpenedAt  DateTime @map("last_opened_at")
  cooldownUntil DateTime @map("cooldown_until")
  expiresAt     DateTime @map("expires_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("operational_auth_alert_states")
}

model AuthOperationalAlertEvaluationAudit {
  correlationId            String   @id @map("correlation_id")
  inputDigest              String   @map("input_digest")
  evaluatedAt              DateTime @map("evaluated_at")
  decision                 String
  candidateCount           Int      @map("candidate_count")
  openCandidateCount       Int      @map("open_candidate_count")
  suppressedCandidateCount Int      @map("suppressed_candidate_count")
  decisionsJson            Json     @map("decisions_json")
  expiresAt                DateTime @map("expires_at")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([evaluatedAt(sort: Desc), correlationId(sort: Desc)], map: "op_auth_alert_eval_audits_page_idx")
  @@map("operational_auth_alert_evaluation_audits")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}
