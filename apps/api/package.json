{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "seed:demo": "ts-node src/erp-local-demo/run-erp-local-demo-seed.ts && ts-node src/learning-local-demo/run-learning-local-demo-seed.ts",
    "test:erp-local": "jest erp-local-demo.service.spec.ts --runInBand",
    "test:learning-local": "jest learning-local-demo.*.spec.ts --runInBand",
    "report:demo": "ts-node src/erp-local-demo/run-erp-local-demo-report.ts && ts-node src/learning-local-demo/run-learning-local-demo-report.ts && ts-node src/learning-local-demo/run-release-candidate-evidence-manifest.ts",
    "verify:release-evidence": "ts-node src/learning-local-demo/run-release-candidate-evidence-manifest.ts",
    "smoke:learning-mvp": "node scripts/smoke-learning-mvp-flow.mjs",
    "smoke:auth-session-disposable": "node scripts/smoke-auth-session-disposable.mjs",
    "smoke:auth-operational-control-disposable": "node scripts/smoke-auth-operational-control-disposable.mjs",
    "smoke:auth-operational-alert-state-disposable": "node scripts/smoke-auth-operational-alert-state-disposable.mjs",
    "uploads:migration:inventory": "ts-node scripts/run-upload-migration-inventory.ts",
    "test:staging-rehearsal-contract": "node --test scripts/staging-rehearsal-contract.test.mjs",
    "test:hosted-migration-contract": "node --test scripts/run-hosted-migration.test.mjs",
    "migrate:hosted-staging": "node scripts/run-hosted-migration.mjs",
    "migrate:hosted-staging:preflight": "node scripts/run-hosted-migration.mjs --preflight-only",
    "rehearse:staging": "node scripts/run-staging-rehearsal.mjs",
    "test": "jest",
    "test:browser-control": "node scripts/test-browser-control.mjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@smithy/node-http-handler": "^4.9.5",
    "@types/nodemailer": "^8.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "minhhuong-learning-platform": "file:../..",
    "nodemailer": "^9.0.3",
    "openai": "^7.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "youtube-transcript-plus": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.13"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
