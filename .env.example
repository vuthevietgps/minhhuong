NODE_ENV=development
# Runtime deployment classification. Leave blank for local development.
DEPLOYMENT_ENVIRONMENT=
PRODUCTION_READY=false
PRODUCTION_ENABLED=false
# Local/demo report routes are always denied when NODE_ENV=production.
LOCAL_DEMO_ROUTES_ENABLED=false

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
# Sau khi tiện ích được duyệt, dán URL Chrome Web Store để nút "Cài vào Chrome" xuất hiện.
NEXT_PUBLIC_EXTENSION_STORE_URL=
JWT_SECRET=change-me-in-production
APP_URL=http://localhost:3000
AFFILIATE_PUBLIC_BASE_URL=https://go.minhhuong.app
AFFILIATE_REDIRECT_BASE_URL=http://localhost:3000
AFFILIATE_HASH_SECRET=replace-with-affiliate-hash-secret
AFFILIATE_ATTRIBUTION_WINDOW_DAYS=30

# Database
DATABASE_URL=postgresql://minhhuong:minhhuong@localhost:5432/minhhuong?schema=public
# Local demo defaults to fixture. Use prisma only with a disposable local/staging DB.
# Production bootstrap rejects fixture or missing provider configuration.
AUTH_SESSION_STORE_PROVIDER=fixture
# Process-local fixture is the local default. The Prisma adapter is allowed only
# for disposable local/staging proof; production remains manual-approval blocked.
AUTH_OPERATIONAL_CONTROL_PROVIDER=fixture
# Required when AUTH_OPERATIONAL_CONTROL_PROVIDER=prisma. Keep server-side and
# use at least 32 random characters so persisted rate keys are HMAC-protected.
AUTH_OPERATIONAL_CONTROL_KEY_SECRET=
# Shared cooldown/dedup state. Fixture is local-process only; Prisma is allowed
# only for disposable-local/staging evidence and remains blocked in production.
AUTH_OPERATIONAL_ALERT_STATE_PROVIDER=fixture

# Hosted-staging/live-provider contract. Keep AI disabled until OpenAI is
# deliberately configured; use AI_CHAT_MOCK_ENABLED only for local UI testing.
NOTIFICATION_PROVIDER=disabled
PAYMENT_PROVIDER=disabled
AI_PROVIDER=disabled
VIDEO_PROVIDER=disabled

# Local development uses filesystem. Hosted staging must use private S3-compatible
# object storage unless a separately authorized single-instance emergency override
# is set. Never commit real credentials; use secret-manager/runtime references.
UPLOAD_STORAGE_PROVIDER=filesystem
UPLOADS_PATH=
UPLOAD_STORAGE_TOPOLOGY=single-instance
UPLOAD_HOSTED_FILESYSTEM_EMERGENCY_OVERRIDE=false
API_REPLICA_COUNT=1
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=
UPLOAD_S3_ENDPOINT=
# Test-only escape hatch for disposable localhost/MinIO HTTP endpoints.
UPLOAD_S3_LOCAL_SMOKE=false
UPLOAD_S3_FORCE_PATH_STYLE=false
UPLOAD_S3_CREDENTIALS_REFERENCE=
UPLOAD_S3_ACCESS_KEY_ID=
UPLOAD_S3_SECRET_ACCESS_KEY=
UPLOAD_S3_KEY_PREFIX=minhhuong-staging
UPLOAD_S3_TIMEOUT_MS=5000
UPLOAD_S3_MAX_ATTEMPTS=3
# Read-only inventory runner remains disabled unless explicitly set to true for
# one localhost dry run. It never contacts the configured object provider.
UPLOAD_MIGRATION_DRY_RUN=false
READINESS_TIMEOUT_MS=3000
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Redis, ready for queues/cache/rate limits
REDIS_URL=redis://localhost:6379

# Email (SMTP) — leave blank to log emails to console only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Minh Huong English <no-reply@minhhuongenglish.com>

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI provider boundary. Keep keys server-side only.
OPENAI_API_KEY=
# Default is gpt-5-mini. Override only after evaluating the tutor prompt.
OPENAI_AI_TUTOR_MODEL=gpt-5-mini
OPENAI_CONTEXT_MODEL=gpt-5-mini
# /ai-contexts uses a separate inexpensive provider; does not enable the AI tutor.
# Set AI_CONTEXT_PROVIDER=deepinfra and add its key to activate video processing.
# Blank AI_CONTEXT_PROVIDER inherits AI_PROVIDER for existing OpenAI installations.
AI_CONTEXT_PROVIDER=disabled
DEEPINFRA_API_KEY=
DEEPINFRA_CONTEXT_MODEL=google/gemma-4-E4B-it
# flex is cheaper; use standard for normal scheduling. No automatic paid fallback.
DEEPINFRA_SERVICE_TIER=flex
# Local-only fallback. Never use mock output to claim live AI tutoring.
AI_CHAT_MOCK_ENABLED=false

# Video provider boundary
VIDEO_SIGNING_SECRET=change-me
